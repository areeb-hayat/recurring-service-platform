# Base URL of the API. Leave empty to use the same origin as the app, which is
# what the Vite dev proxy provides locally and what a single-origin deployment
# provides in production. Set it only when the API is served from another origin,
# in which case that origin must also be listed in the backend's CORS_ORIGINS.
VITE_API_BASE_URL=

# Where the dev server proxies /api to. Local backend by default.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
