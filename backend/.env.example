# Copy to .env and fill in. NEVER commit a filled-in .env — it is git-ignored.
# Names only; every value here is intentionally empty.

# ---------------------------------------------------------------------------
# Used by P1
# ---------------------------------------------------------------------------
# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
# Signing key for short-lived access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# development | test | production
ENVIRONMENT=
LOG_LEVEL=
# Comma-separated origins, e.g. http://localhost:5173
CORS_ORIGINS=

# PostgreSQL database used by the test suite. Schema/constraint tests require a
# real PostgreSQL instance and are skipped (never silently weakened) without it.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Used by P7 (reminder engine)
# ---------------------------------------------------------------------------
# Shared secret the host's cron presents to POST /internal/jobs/run-daily.
# UNSET DISABLES THE ENDPOINT (503) — it is never left open. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_JOB_SECRET=
# Which communication adapter delivers reminders. Only "mock" exists in V1; it
# records messages in memory and sends nothing. Real transport is P10.
COMMS_PROVIDER=

# ---------------------------------------------------------------------------
# Reserved by the P0 architecture freeze (§13) — NOT read by current code.
# Listed so deployment configuration is discoverable in one place.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_ENABLED=
SPEECH_PROVIDER=
SPEECH_MODEL=
VOICE_ENABLED=
